{
  "name": "vpsctl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "vpsctl": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "bun build src/cli.ts --compile --outfile dist/vpsctl"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
